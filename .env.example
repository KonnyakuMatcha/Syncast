# Public DNS A/AAAA record pointing at this server.
SYNCAST_DOMAIN=syncast.example.com

# STUN discovers peer addresses but never relays media.
RTC_STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302

# Optional server broadcasting, enabled by adding compose.broadcast.yaml.
# Set the VPS public IPv4; forward/open 7881/TCP and 7882/UDP at the same ports.
# SYNCAST_PUBLIC_IP=203.0.113.10
# LIVEKIT_API_KEY=syncast
# Generate a secret with: openssl rand -hex 32
# LIVEKIT_API_SECRET=
# Override for a nonstandard HTTPS port or an external LiveKit service:
# SYNCAST_LIVEKIT_URL=wss://syncast.example.com:8965/Syncast/sfu
